# Konfigurasi RUNTIME doa-revamp — salin ke `.env` lalu isi nilainya.
#
# Dibaca saat server START, jadi jalankan build dengan:
#     node --env-file=.env build
# Ubah nilai di .env + RESTART proses = langsung berlaku, TANPA build ulang.
# (Berguna saat password email dipaksa ganti berkala.)

# Endpoint upload dokumen (up.php)
PUBLIC_UPLOAD_URL=http://10.1.95.76/webdoa/up.php

# ── Koneksi Database ──
# Ganti server = ubah di sini + restart (tanpa rebuild).
#   Lokal (dev):     DB_HOST=127.0.0.1   DB_USER=root        DB_PASS=            DB_NAME=doan
#   Server lama 5.1: DB_HOST=10.1.95.76  DB_USER=doa-revamp  DB_PASS=<rahasia>   DB_NAME=standard
#   Server baru 5.7: DB_HOST=100.64.0.3  DB_USER=<user>      DB_PASS=<rahasia>   DB_NAME=standard
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=doan

# ── Email surat pernyataan ──
MAIL_HOST=10.1.0.6
MAIL_PORT=25
MAIL_FROM=email
MAIL_USER=email
MAIL_PASS=password
# Mode uji: SEMUA email dialihkan ke alamat ini supaya tak mengirim ke orang asli.
# KOSONGKAN baris ini (TEST_EMAIL_OVERRIDE=) untuk PRODUKSI.
TEST_EMAIL_OVERRIDE=
# Nomor form (EST/Form 482) → "Surat Pernyataan 482-<seri> <nama>"
SURAT_FORM_NO=482

# Folder simpan PDF surat pernyataan (UNC Windows / path Linux hasil mount CIFS).
# Opsional — kalau tak diisi, pakai default yang ada di kode.
# SURAT_PERNYATAAN_DIR=/mnt/surat
# (Opsional, Linux) override path binary LibreOffice kalau tak ada di PATH:
# SOFFICE_BIN=/usr/bin/soffice
# (Opsional) path absolut template.docx kalau service tak jalan dari root project:
# SURAT_TEMPLATE=/opt/doa-revamp/template.docx
